diff --git a/include/jsoncons_ext/jsonschema/common/duckdb_support.hpp b/include/jsoncons_ext/jsonschema/common/duckdb_support.hpp
new file mode 100644
index 0000000..b2139fb
--- /dev/null
+++ b/include/jsoncons_ext/jsonschema/common/duckdb_support.hpp
@@ -0,0 +1,86 @@
+// Query.Farm patch (DuckDB json_schema extension). Schemas and documents are untrusted input:
+//
+// * schema_regex: "pattern", "patternProperties" and "format": "regex" are attacker-controlled, and
+//   std::regex backtracks recursively (stack overflow / exponential time). DuckDB's bundled RE2 is used
+//   instead: linear time, bounded memory, no recursion. RE2 does not support backreferences or lookaround;
+//   such patterns are rejected as schema errors.
+// * stack_guard: compiling and evaluating a schema recurse once per level of schema/document nesting (and
+//   per $ref hop). The host sets the lowest stack address this thread may reach; every recursion step checks
+//   it and throws a schema_error instead of overflowing the (possibly small) thread stack.
+
+#ifndef JSONCONS_EXT_JSONSCHEMA_COMMON_DUCKDB_SUPPORT_HPP
+#define JSONCONS_EXT_JSONSCHEMA_COMMON_DUCKDB_SUPPORT_HPP
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <string>
+
+#include "re2/re2.h"
+
+#include <jsoncons/config/jsoncons_config.hpp>
+#include <jsoncons_ext/jsonschema/jsonschema_error.hpp>
+
+namespace jsoncons {
+namespace jsonschema {
+
+    class stack_guard
+    {
+    public:
+        //! Lowest stack address the current thread may reach; 0 disables the check
+        static std::uintptr_t& limit()
+        {
+            static thread_local std::uintptr_t value = 0;
+            return value;
+        }
+
+        static void check()
+        {
+            volatile char marker = 0;
+            auto sp = reinterpret_cast<std::uintptr_t>(&marker);
+            auto lowest = limit();
+            if (lowest != 0 && sp < lowest)
+            {
+                JSONCONS_THROW(schema_error("JSON schema evaluation ran out of stack: the schema or document is nested too deeply"));
+            }
+        }
+    };
+
+    class schema_regex
+    {
+        std::shared_ptr<const duckdb_re2::RE2> re_;
+
+        static std::shared_ptr<const duckdb_re2::RE2> compile(const std::string& pattern)
+        {
+            duckdb_re2::RE2::Options options;
+            options.set_log_errors(false);
+            return std::make_shared<const duckdb_re2::RE2>(pattern, options);
+        }
+
+    public:
+        explicit schema_regex(const std::string& pattern)
+            : re_(compile(pattern))
+        {
+            if (!re_->ok())
+            {
+                JSONCONS_THROW(schema_error("Invalid or unsupported regular expression '" + pattern + "': " + re_->error()));
+            }
+        }
+
+        //! Whether the pattern compiles (used for "format": "regex")
+        static bool is_valid(const char* data, std::size_t length)
+        {
+            return compile(std::string(data, length))->ok();
+        }
+
+        //! Unanchored search, as ECMA-262 RegExp.prototype.test()
+        bool search(const char* data, std::size_t length) const
+        {
+            return duckdb_re2::RE2::PartialMatch(duckdb_re2::StringPiece(data, length), *re_);
+        }
+    };
+
+} // namespace jsonschema
+} // namespace jsoncons
+
+#endif // JSONCONS_EXT_JSONSCHEMA_COMMON_DUCKDB_SUPPORT_HPP
